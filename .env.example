# Yandex Cloud 
#YC_API_KEY=
#YC_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt-lite

# HH.ru API
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HF_TOKEN=

# n8n интеграция
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=http://n8n:5678

# База данных (PostgreSQL в Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@competency-postgres:5432/compare_competencies
DATABASE_URL_HOST=postgresql+asyncpg://postgres:postgres@localhost:5432/compare_competencies
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compare_competencies
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Security
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Ollama / Qwen настройка (внешняя университетская ollama)
OLLAMA_URL=http://ollama8.r61.net:11434
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_EMBEDDING_MODEL=qwen2.5:0.5b
EMBEDDING_DIM=768
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=2000

# File Upload Settings
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt

# Логирование
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# n8n DB
N8N_DB_PASSWORD=n8n_password_change_me
N8N_ENCRYPTION_KEY=change-me-to-a-random-key

# Open WebUI
WEBUI_SECRET_KEY=change-me-to-a-random-key

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# DevSet
DEBUG=True
ENVIRONMENT=development
