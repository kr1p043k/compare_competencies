# Yandex Cloud 
#YC_API_KEY=
#YC_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt-lite

# HH.ru API
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Готовый OAuth-токен соискателя (HH закрыл /vacancies для анонимных запросов).
# Приоритетнее client credentials.
#HH_ACCESS_TOKEN=
HF_TOKEN=

# Тюнинг клиента hh.ru (кодовые дефолты, менять осознанно)
#HH_USER_AGENT=CompetencyAnalyzer (kok.yoko@gmx.com)
#REQUEST_DELAY=0.1
#MAX_RETRIES=3
#RETRY_DELAY=2.0
#PIPELINE_RETRIES=2

# Параметры поиска вакансий по умолчанию
#DEFAULT_AREA=1
#DEFAULT_PERIOD_DAYS=30
#DEFAULT_MAX_PAGES=20
#DEFAULT_PER_PAGE=100

# n8n интеграция
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=http://n8n:5678

# База данных (PostgreSQL в Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@competency-postgres:5432/compare_competencies
# Логировать SQL-запросы (SQLAlchemy echo), для отладки
DATABASE_ECHO=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=compare_competencies

# Backend Security
# Сгенерировать: SECRET_KEY=$(openssl rand -hex 32)
# Значение ниже специально из deny-list — скопированный пример НЕ запустится.
SECRET_KEY=change-me-to-random-string
TOKEN_TTL_DAYS=7

# Сервисный токен для скрейпинга /metrics (Prometheus).
# Пусто - /metrics доступен только роли admin.
# METRICS_TOKEN=$(openssl rand -hex 32)

# Academic API (ЮФУ): SSO с хаба + прокси компетенций
ACADEMIC_API_BASE=https://academic-api.lib.sfedu.ru
# Отдельный хост Course Trends API (предрассчитанные рекомендации и статьи).
# Старый API остаётся для /get-competencies и /analyze-gap.
ACADEMIC_TRENDS_API_BASE=https://academic-api-dev.lib.sfedu.ru
ACADEMIC_EMAIL_DOMAIN=sfedu.ru
ACADEMIC_SSO_ENABLED=true

# Hub ЮФУ: публикации (список открыт, токен нужен только для карточки /api/assets/{id}/)
HUB_API_BASE=https://hub.sfedu.ru
HUB_API_TOKEN=
HUB_API_TIMEOUT_S=30
HUB_CACHE_TTL_S=120

# Hub-gate: вето семантических матчей серой зоны к хаб-навыкам (default ON).
# Таблица data/reference/market_hubs.json, пересобирается при смене маркета.
HUB_GATE_ENABLED=true
HUB_GATE_HUB_T=200
HUB_GATE_MORPH_M=0.2
HUB_GATE_ULTRA_HUB=1000
HUB_GATE_SIM_LO=0.6
HUB_GATE_SIM_HI=0.75
HUB_TABLE_PATH=data/reference/market_hubs.json

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Ollama / gpt-oss настройка (внешняя университетская ollama)
OLLAMA_URL=http://ollama8.r61.net:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_EMBEDDING_MODEL=qwen2.5:0.5b
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=2000

# LLM chat client (шлюз reformboss, ключ-1). URL уже оканчивается на /v1,
# ключ (если нужен) читается из env LLM_CHAT_API_KEY, пусто = без ключа.
LLM_CHAT_URL=http://127.0.0.1:8797/k1/v1
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# File Upload Settings
MAX_REQUEST_SIZE=20971520

# Embeddings / LLM (зеркало рекомендаций; все ENHANCE/EXTRACT выключены по умолчанию)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
LLM_ENABLED=true
LLM_ENHANCE_STUDENT=false
LLM_ENHANCE_TEACHER=false
LLM_EXTRACT=false
LLM_TIMEOUT_S=60

# LLM semantic judge (opt-in stub, по умолчанию off).
# Судья семантического хвоста: пары из косинусной серой зоны.
# Без URL/ключа - тихий skip.
#LLM_JUDGE_ENABLED=false
#LLM_JUDGE_URL=
#LLM_JUDGE_API_KEY=
#LLM_JUDGE_MODEL=
#LLM_JUDGE_TIMEOUT_S=30
#LLM_JUDGE_MAX_PAIRS=200

# Telegram уведомления (опционально)
#TELEGRAM_BOT_TOKEN=

# Логирование
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_FILE=/app/logs/backend.log

# n8n DB
N8N_DB_PASSWORD=n8n_password_change_me
N8N_ENCRYPTION_KEY=change-me-to-a-random-key

# Open WebUI
WEBUI_SECRET_KEY=change-me-to-a-random-key

# Grafana
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-strong-password

# Планировщик фоновых задач (seed; дальше — тумблеры в админке)
#BACKGROUND_COLLECTOR_ENABLED=false
#SCHEDULER_COLLECT_INTERVAL_HOURS=12
#SCHEDULER_DAILY_GAP_ENABLED=false

# --- Тюнинг алгоритмов (кодовые дефолты; переопределять осознанно) ---
# Скала косинусной близости: единая лестница решений "это одно и то же"
#SIM_DEDUP=0.82
#SIM_SKILL_MATCH=0.78
#SIM_MARKET_MATCH_HIGH=0.75
#SIM_MARKET_MATCH_MEDIUM=0.65
#SIM_ACADEMIC_GAP=0.6
#SIM_ACADEMIC_MARKET=0.45
# BM25
#BM25_MAX_CORPUS_DOCS=200
#BM25_MIN_SCORE=0.005
# PCA
#PCA_ENABLED=true
#PCA_TARGET_DIM=256
#PCA_MIN_SAMPLES=100
#PCA_MIN_FEATURES=128
# Рекомендации и gap-анализ
#BLEND_EVALUATOR_WEIGHT=0.4
#BLEND_LTR_WEIGHT=0.6
#DOMAIN_BONUS=0.1
#DIVERSIFY_MAX_PER_CATEGORY=3
#PRIORITY_HIGH_THRESHOLD=0.4
#PRIORITY_MEDIUM_THRESHOLD=0.2
#TREND_ALWAYS_HOT_BONUS=0.15
#READINESS_MARKET_WEIGHT=0.45
#READINESS_SKILL_WEIGHT=0.30
#READINESS_DOMAIN_WEIGHT=0.0
#READINESS_GAP_PENALTY_WEIGHT=-0.25
#SKILL_STRONG_GAP_THRESHOLD=0.2
#SKILL_WEAK_GAP_THRESHOLD=0.6
#DOMINANT_DOMAIN_WEIGHT=0.5
#GAP_ANALYZER_FALLBACK_MIN_GAP=0.05
#GAP_ANALYZER_FALLBACK_REDUCTION=0.65
# Воспроизводимость и прочее
#GLOBAL_RANDOM_SEED=42
#TQDM_DISABLE=false
#PYDANTIC_VALIDATION_ENABLED=true

# Поля путей (DATA_DIR, *_PATH, *_DIR, LOG_FILE, HUB_TABLE_PATH и т.п.),
# PROFILES_DISCIPLINES и LEVEL_WEIGHTS_MAP — внутренние, задаются кодом.
# Переопределяйте их через env только при нестандартной раскладке проекта.
