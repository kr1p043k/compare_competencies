                "example": { "run_id": "27d92cd1-ae91-435d-80bf-603caf8c5e3a", "action": "teacher-analysis", "status": "started", "started_at": "2026-08-18T04:41:16+00:00", "completed_at": null, "error": null, "stats": {} }
              }
            }
          },
          "400": { "description": "Неверный run_id" },
          "401": { "description": "Не авторизован" },
          "403": { "description": "Недостаточно прав" },
          "404": { "description": "Запуск не найден" }
        }
      }
    },
    "/teacher/zun/import/{dir_code}": {
      "post": {
        "operationId": "zun_import",
        "tags": ["zun"],
        "summary": "Импорт ЗУН из KRM JSON",
        "description": "Импортирует ЗУН из data/reference/krm_disciplines_{dir_code}.json в ksa_entries. Идемпотентно: перед вставкой проверяется наличие (competency_id, ksa_type, original_text) — дубли пропускаются. Gap-fill: если категория (ksa_type) у компетенции уже заполнена в БД — весь блок пропускается (skipped_gap). parse_version_id = NULL. При dry_run=true ничего не записывает, только считает.",
        "parameters": [
          { "name": "dir_code", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "dry_run", "in": "query", "required": false, "schema": { "type": "boolean", "default": false }, "description": "Только посчитать, без записи" }
        ],
        "responses": {
          "200": {
            "description": "Результат импорта",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportResult" },
                "example": { "dir_code": "09.03.02", "inserted": 905, "skipped_dups": 139, "skipped_gap": 0, "disciplines_processed": 26 }
              }
            }
          },
          "400": { "description": "Неверный dir_code или нет контейнера disciplines в KRM" },
          "401": { "description": "Не авторизован" },
          "403": { "description": "Недостаточно прав" },
          "404": { "description": "Направление или KRM-файл не найден" }
        }
      }
    }
  }
