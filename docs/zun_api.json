    "/teacher/zun/search/semantic": {
      "get": {
        "operationId": "zun_search_semantic",
        "tags": ["zun"],
        "summary": "Семантический поиск по тексту ЗУН",
        "description": "Векторный поиск по тексту ЗУН. Запрос кодируется эмбеддинг-моделью (EmbeddingProviderFactory, как в map_ksa_to_skills), сравнивается косинусной близостью с in-memory кэшем эмбеддингов всех ЗУН направления (пересчитывается по MAX(created_at) и TTL 600 с). Возвращает top-N с similarity. Если эмбеддинги недоступны — переключается в режим fallback_substring (обычный ILIKE) и возвращает mode='fallback_substring'.",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2 } },
          { "name": "dir_code", "in": "query", "required": false, "schema": { "type": "string", "default": "09.03.02" } },
          { "name": "ksa_type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["knowledge", "abilities", "skills"] } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Семантические совпадения",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": { "type": "string", "enum": ["semantic", "fallback_substring"] },
                    "query": { "type": "string" },
                    "matches": { "type": "array", "items": { "$ref": "#/components/schemas/SemanticMatch" } }
                  }
                },
                "example": {
                  "mode": "semantic",
                  "query": "машинное обучение",
                  "matches": [
                    { "ksa_id": "...", "ksa_type": "knowledge", "original_text": "этапы процесса машинного обучения, включая...", "competence_id": "...", "competence_code": "ОПК-4", "is_indicator": false, "parent_code": null, "discipline_id": "...", "discipline_name": "Python для научных вычислений и машинного обучения", "similarity": 0.892 }
                  ]
                }
              }
            }
          },
          "400": { "description": "q меньше 2 символов" },
          "401": { "description": "Не авторизован" },
          "403": { "description": "Недостаточно прав" },
          "404": { "description": "Направление не найдено" }
        }
      }
    },
